# OS
.DS_Store

# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo

# Python bytecode
__pycache__/
*.py[cod]

# Generated API data (rebuilt by build_data_api.py)
public/api/v1/pokemon/
public/api/v1/moves/
public/api/v1/types/
public/api/v1/natures/
public/api/v1/generations.json

# Sprite binary assets (downloaded via scripts/setup-sprites.sh)
public/data/pokemon/*/sprites/

# Sprite tarball (local build artifact)
pokemon-sprites.tar.gz

# Machine-local agent settings (AGENTS.md / CLAUDE.md are intentionally tracked)
.claude/settings.local.json
