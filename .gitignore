# OS
.DS_Store

# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo

# Python bytecode
__pycache__/
*.py[cod]

# --- What is tracked, and why ------------------------------------------------
# public/data/**  is the SOURCE OF TRUTH for Pokemon data. It stays in git.
#                 Do not add it here, and do not "clean it up" as build output.
# public/api/v1/** is generated from public/data on every build -> ignored below.
# src/data/fullRoster.json is a TRACKED BUILD INPUT. inline_dist.py reads it as
#                 the primary source of window.__POKEMON_DATA__ and silently
#                 falls back to a thinner payload if it is missing. Do not
#                 untrack it.
# -----------------------------------------------------------------------------

# Generated API data (rebuilt by build_data_api.py)
public/api/v1/pokemon/
public/api/v1/moves/
public/api/v1/types/
public/api/v1/natures/
public/api/v1/generations.json

# Sprite binary assets (downloaded via scripts/setup-sprites.sh)
public/data/pokemon/*/sprites/

# Sprite tarball (local build artifact)
pokemon-sprites.tar.gz

# Machine-local agent settings (AGENTS.md / CLAUDE.md are intentionally tracked)
.claude/settings.local.json
